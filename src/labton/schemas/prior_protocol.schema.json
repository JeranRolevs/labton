{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "target", "likelihood", "candidates", "evidence", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parameter", "population", "observation_unit", "success_definition"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "parameter": {"$ref": "#/$defs/text"}, "population": {"$ref": "#/$defs/text"},
        "observation_unit": {"$ref": "#/$defs/text"}, "success_definition": {"$ref": "#/$defs/text"}
      }
    },
    "likelihood": {"const": "binomial"},
    "candidates": {
      "type": "array", "minItems": 3, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "family", "a", "b", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "family": {"const": "beta"},
          "a": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
          "b": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
          "rationale": {"$ref": "#/$defs/text"}
        }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["prior", "validation", "likelihood"],
      "properties": {
        "prior": {"$ref": "#/$defs/sources"}, "validation": {"$ref": "#/$defs/sources"},
        "likelihood": {"$ref": "#/$defs/sources"}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["predictive_trials", "plausible_rate_range", "max_outside_mass", "min_validation_tail", "posterior_threshold", "decision_probability", "material_mean_shift"],
      "properties": {
        "predictive_trials": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "plausible_rate_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/probability"}},
        "max_outside_mass": {"$ref": "#/$defs/probability"},
        "min_validation_tail": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "posterior_threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "decision_probability": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "material_mean_shift": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "sources": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/source"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "file", "dataset_id", "observation_ids", "lineage_ids", "relevance"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "file": {"$ref": "#/$defs/text"},
        "dataset_id": {"$ref": "#/$defs/text"}, "observation_ids": {"$ref": "#/$defs/ids"},
        "lineage_ids": {"$ref": "#/$defs/ids"}, "relevance": {"$ref": "#/$defs/text"},
        "counts": {
          "type": "object", "additionalProperties": false, "required": ["successes", "trials"],
          "properties": {"successes": {"type": "integer", "minimum": 0, "maximum": 1000000}, "trials": {"type": "integer", "minimum": 1, "maximum": 1000000}}
        }
      }
    }
  }
}
